-px z-[2] rounded-[inherit] opacity-55 [box-shadow:inset_0_0_1px_0.8px_color-mix(in_oklab,var(--violet-deep)_60%,var(--foreground))] [mask-image:linear-gradient(var(--border-shine-angle,-35deg),#ffffff80,#ffffff30_30%_60%,#fff)]"></span><div class="lineup-time"><time dateTime="15:40">15:40</time><span class="lineup-end"><span class="sr-only"> to </span><span aria-hidden="true">— </span><time dateTime="15:50">15:50</time></span></div><div class="lineup-panel [&amp;:has(&gt;details:not([open]))]:pb-0! "><div class="lineup-topic"><span class="lineup-lightning"><svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" aria-hidden="true" class="remixicon "><path d="M13 10H20L11 23V14H4L13 1V10Z"></path></svg>Lightning talk</span><h4>Decoupling Serverless Systems: Building Resilient Architectures with AWS SNS and SQS</h4></div><div class="lineup-speakers"><div class="lineup-speaker"><p class="lineup-speaker-name"><a href="index.html#speaker-shamshod-isaev" aria-label="View Shamshod Isaev&#x27;s speaker card" class="inline-flex min-h-11 items-center gap-2 rounded-sm text-inherit underline decoration-dotted decoration-current/50 underline-offset-4 hover:text-coral hover:decoration-coral/50 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary">Shamshod Isaev</a></p><p class="lineup-affiliation">Senior Software Engineer, EPAM Systems</p></div></div><details class="group/talk col-span-full mt-5 min-w-0 border-t border-current/10"><summary class="flex min-h-14 w-fit cursor-pointer list-none items-center gap-2 rounded-sm text-sm font-semibold text-coral hover:text-foreground focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary [&amp;::-webkit-details-marker]:hidden"><svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" aria-hidden="true" class="remixicon size-4 shrink-0 group-open/talk:rotate-180 motion-safe:transition-transform motion-safe:duration-150"><path d="M11.9999 13.1714L16.9497 8.22168L18.3639 9.63589L11.9999 15.9999L5.63599 9.63589L7.0502 8.22168L11.9999 13.1714Z"></path></svg><span class="group-open/talk:hidden">About this talk</span><span class="hidden group-open/talk:inline">Hide description</span><span class="sr-only">: <!-- -->Decoupling Serverless Systems: Building Resilient Architectures with AWS SNS and SQS</span></summary><p class="max-w-[68ch] pb-1 text-sm leading-relaxed text-muted-foreground">Decouple serverless applications and handle high-volume traffic with Amazon SNS and SQS. Learn pub/sub and fanout messaging patterns, along with dead-letter queues and FIFO ordering for more resilient systems.</p></details><div class="lineup-portraits"><div class="lineup-pop-portrait" data-speaker="Shamshod Isaev"><span aria-hidden="true" data-portrait-glow="" class="pointer-events-none absolute inset-0 rounded-full bg-[color:color-mix(in_oklab,var(--violet-deep)_55%,var(--foreground))] opacity-20 blur-xl"></span><span class="lineup-portrait-circle" aria-hidden="true"><span class="absolute inset-0 rounded-full bg-[radial-gradient(circle_at_50%_65%,#4e0abb,transparent_75%)] opacity-30"></span></span><div class="lineup-portrait-crop"><img src="speakers/isaev.webp" srcSet="speakers/responsive/isaev-368.webp 368w, speakers/responsive/isaev-736.webp 736w, speakers/isaev.webp 1100w" sizes="(max-width: 700px) 150px, 177px" alt="Shamshod Isaev" loading="lazy" width="1100" height="1320"/></div></div></div></div></li><li id="talk-1550" tabindex="-1" class="lineup-session group/session scroll-mt-28 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary" data-kind="lightning" data-has-portrait="true" data-compact="true"><span aria-hidden="true" data-border-shine="" class="pointer-events-none absolute -inset-px z-[2] rounded-[inherit] opacity-55 [box-shadow:inset_0_0_1px_0.8px_color-mix(in_oklab,var(--violet-deep)_60%,var(--foreground))] [mask-image:linear-gradient(var(--border-shine-angle,-35deg),#ffffff80,#ffffff30_30%_60%,#fff)]"></span><div class="lineup-time"><time dateTime="15:50">15:50</time><span class="lineup-end"><span class="sr-only"> to </span><span aria-hidden="true">— </span><time dateTime="16:00">16:00</time></span></div><div class="lineup-panel [&amp;:has(&gt;details:not([open]))]:pb-0! "><div class="lineup-topic"><span class="lineup-lightning"><svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" aria-hidden="true" class="remixicon "><path d="M13 10H20L11 23V14H4L13 1V10Z"></path></svg>Lightning talk</span><h4>Lambda MicroVM vs AWS Fargate</h4></div><div class="lineup-speakers"><div class="lineup-speaker"><p class="lineup-speaker-name"><a href="index.html#speaker-arman-nurgaliyev" aria-label="View Arman Nurgaliyev&#x27;s speaker card" class="inline-flex min-h-11 items-center gap-2 rounded-sm text-inherit underline decoration-dotted decoration-current/50 underline-offset-4 hover:text-coral hover:decoration-coral/50 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary">Arman Nurgaliyev</a></p><p class="lineup-affiliation">CTO, Cloud Agnostic</p></div></div><details class="group/talk col-span-full mt-5 min-w-0 border-t border-current/10"><summary class="flex min-h-14 w-fit cursor-pointer list-none items-center gap-2 rounded-sm text-sm font-semibold text-coral hover:text-foreground focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary [&amp;::-webkit-details-marker]:hidden"><svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" aria-hidden="true" class="remixicon size-4 shrink-0 group-open/talk:rotate-180 motion-safe:transition-transform motion-safe:duration-150"><path d="M11.9999 13.1714L16.9497 8.22168L18.3639 9.63589L11.9999 15.9999L5.63599 9.63589L7.0502 8.22168L11.9999 13.1714Z"></path></svg><span class="group-open/talk:hidden">About this talk</span><span class="hidden group-open/talk:inline">Hide description</span><span class="sr-only">: <!-- -->Lambda MicroVM vs AWS Fargate</span></summary><p class="max-w-[68ch] pb-1 text-sm leading-relaxed text-muted-foreground">Compare Lambda Functions, Lambda MicroVMs and AWS Fargate, and learn when to choose each. The talk breaks down how these compute options differ and where each fits in an AWS architecture.</p></details><div class="lineup-portraits"><div class="lineup-pop-portrait" data-speaker="Arman Nurgaliyev"><span aria-hidden="true" data-portrait-glow="" class="pointer-events-none absolute inset-0 rounded-full bg-[color:color-mix(in_oklab,var(--violet-deep)_55%,var(--foreground))] opacity-20 blur-xl"></span><span class="lineup-portrait-circle" aria-hidden="true"><span class="absolute inset-0 rounded-full bg-[radial-gradient(circle_at_50%_65%,#4e0abb,transparent_75%)] opacity-30"></span></span><div class="lineup-portrait-crop"><img src="speakers/nurgaliyev.webp" srcSet="speakers/responsive/nurgaliyev-368.webp 368w, speakers/responsive/nurgaliyev-736.webp 736w, speakers/nurgaliyev.webp 1100w" sizes="(max-width: 700px) 150px, 177px" alt="Arman Nurgaliyev" loading="lazy" width="1100" height="1320"/></div></div></div></div></li></ol></li><li id="talk-1600" tabindex="-1" class="lineup-session group/session scroll-mt-28 focus-visible:outline-none" data-kind="talk" data-has-portrait="true" data-compact="false"><div class="lineup-time"><time dateTime="16:00">16:00</time><span class="lineup-end"><span class="sr-only"> to </span><span aria-hidden="true">— </span><time dateTime="16:30">16:30</time></span></div><div class="lineup-panel [&amp;:has(&gt;details:not([open]))]:pb-0! group-focus-visible/session:outline-2 group-focus-visible/session:outline-offset-4 group-focus-visible/session:outline-primary"><span aria-hidden="true" data-border-shine="" class="pointer-events-none absolute -inset-px z-[2] rounded-[inherit] opacity-55 [box-shadow:inset_0_0_1px_0.8px_color-mix(in_oklab,var(--violet-deep)_60%,var(--foreground))] [mask-image:linear-gradient(var(--border-shine-angle,-35deg),#ffffff80,#ffffff30_30%_60%,#fff)]"></span><div class="lineup-topic"><h4>We Deleted the File That Ordered Our Infrastructure — and Applies Got 2x Faster</h4></div><div class="lineup-speakers"><div class="lineup-speaker"><p class="lineup-speaker-name"><a href="index.html#speaker-alex-plotnikov" aria-label="View Alex Plotnikov&#x27;s speaker card" class="inline-flex min-h-11 items-center gap-2 rounded-sm text-inherit underline decoration-dotted decoration-current/50 underline-offset-4 hover:text-coral hover:decoration-coral/50 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary">Alex Plotnikov</a></p><p class="lineup-affiliation">Staff Cloud Engineer, inDrive</p></div></div><details class="group/talk col-span-full mt-5 min-w-0 border-t border-current/10"><summary class="flex min-h-14 w-fit cursor-pointer list-none items-center gap-2 rounded-sm text-sm font-semibold text-coral hover:text-foreground focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary [&amp;::-webkit-details-marker]:hidden"><svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" aria-hidden="true" class="remixicon size-4 shrink-0 group-open/talk:rotate-180 motion-safe:transition-transform motion-safe:duration-150"><path d="M11.9999 13.1714L16.9497 8.22168L18.3639 9.63589L11.9999 15.9999L5.63599 9.63589L7.0502 8.22168L11.9999 13.1714Z"></path></svg><span class="group-open/talk:hidden">About this talk</span><span class="hidden group-open/talk:inline">Hide description</span><span class="sr-only">: <!-- -->We Deleted the File That Ordered Our Infrastructure — and Applies Got 2x Faster</span></summary><p class="max-w-[68ch] pb-1 text-sm leading-relaxed text-muted-foreground">See how replacing a manual ordering file with a trusted dependency graph enabled parallel applies across roughly 14,000 Terragrunt modules. Learn how dependency audits, Open Policy Agent checks and layered GitHub Actions jobs made the change safe, cut average apply times in half, and handled concurrency and AWS API limits.</p></details><div class="lineup-portraits"><div class="lineup-pop-portrait" data-speaker="Alex Plotnikov"><span aria-hidden="true" data-portrait-glow="" class="pointer-events-none absolute inset-0 rounded-full bg-[color:color-mix(in_oklab,var(--violet-deep)_55%,var(--foreground))] opacity-20 blur-xl"></span><span class="lineup-portrait-circle" aria-hidden="true"><span class="absolute inset-0 rounded-full bg-[radial-gradient(circle_at_50%_65%,#4e0abb,transparent_75%)] opacity-30"></span></span><div class="lineup-portrait-crop"><img src="speakers/plotnikov.webp" srcSet="speakers/responsive/plotnikov-368.webp 368w, speakers/responsive/plotnikov-736.webp 736w, speakers/plotnikov.webp 1100w" sizes="(max-width: 700px) 150px, 204px" alt="Alex Plotnikov" loading="lazy" width="1100" height="1320"/></div></div></div></div></li><li id="talk-1630" tabindex="-1" class="lineup-session group/session scroll-mt-28 focus-visible:outline-none" data-kind="talk" data-has-portrait="true" data-compact="false"><div class="lineup-time"><time dateTime="16:30">16:30</time><span class="lineup-end"><span class="sr-only"> to </span><span aria-hidden="true">— </span><time dateTime="17:00">17:00</time></span></div><div class="lineup-panel [&amp;:has(&gt;details:not([open]))]:pb-0! group-focus-visible/session:outline-2 group-focus-visible/session:outline-offset-4 group-focus-visible/session:outline-primary"><span aria-hidden="true" data-border-shine="" class="pointer-events-none absolute -inset-px z-[2] rounded-[inherit] opacity-55 [box-shadow:inset_0_0_1px_0.8px_color-mix(in_oklab,var(--violet-deep)_60%,var(--foreground))] [mask-image:linear-gradient(var(--border-shine-angle,-35deg),#ffffff80,#ffffff30_30%_60%,#fff)]"></span><div class="lineup-topic"><h4>Kubernetes probes: you think you know them</h4></div><div class="lineup-speakers"><div class="lineup-speaker"><p class="lineup-speaker-name"><a href="index.html#speaker-alex-dovnar" aria-label="View Alex Dovnar&#x27;s speaker card" class="inline-flex min-h-11 items-center gap-2 rounded-sm text-inherit underline decoration-dotted decoration-current/50 underline-offset-4 hover:text-coral hover:decoration-coral/50 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary">Alex Dovnar</a></p><p class="lineup-affiliation">CTO, Naviteq LTD</p></div></div><details class="group/talk col-span-full mt-5 min-w-0 border-t border-current/10"><summary class="flex min-h-14 w-fit cursor-pointer list-none items-center gap-2 rounded-sm text-sm font-semibold text-coral hover:text-foreground focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary [&amp;::-webkit-details-marker]:hidden"><svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" aria-hidden="true" class="remixicon size-4 shrink-0 group-open/talk:rotate-180 motion-safe:transition-transform motion-safe:duration-150"><path d="M11.9999 13.1714L16.9497 8.22168L18.3639 9.63589L11.9999 15.9999L5.63599 9.63589L7.0502 8.22168L11.9999 13.1714Z"></path></svg><span class="group-open/talk:hidden">About this talk</span><span class="hidden group-open/talk:inline">Hide description</span><span class="sr-only">: <!-- -->Kubernetes probes: you think you know them</span></summary><p class="max-w-[68ch] pb-1 text-sm leading-relaxed text-muted-foreground">Revisit Kubernetes probes through a live demonstration on an AWS cluster with a real database and real load. See how familiar YAML settings can cause a healthy service to fail, and learn what to look for beyond a copied configuration.</p></details><div class="lineup-portraits"><div class="lineup-pop-portrait" data-speaker="Alex Dovnar"><span aria-hidden="true" data-portrait-glow="" class="pointer-events-none absolute inset-0 rounded-full bg-[color:color-mix(in_oklab,var(--violet-deep)_55%,var(--foreground))] opacity-20 blur-xl"></span><span class="lineup-portrait-circle" aria-hidden="true"><span class="absolute inset-0 rounded-full bg-[radial-gradient(circle_at_50%_65%,#4e0abb,transparent_75%)] opacity-30"></span></span><div class="lineup-portrait-crop"><img src="speakers/dovnar.webp" srcSet="speakers/responsive/dovnar-368.webp 368w, speakers/responsive/dovnar-736.webp 736w, speakers/dovnar.webp 1100w" sizes="(max-width: 700px) 150px, 204px" alt="Alex Dovnar" loading="lazy" width="1100" height="1320"/></div></div></div></div></li><li id="talk-1700" tabindex="-1" class="lineup-session group/session scroll-mt-28 focus-visible:outline-none" data-kind="talk" data-has-portrait="true" data-compact="false"><div class="lineup-time"><time dateTime="17:00">17:00</time><span class="lineup-end"><span class="sr-only"> to </span><span aria-hidden="true">— </span><time dateTime="17:30">17:30</time></span></div><div class="lineup-panel [&amp;:has(&gt;details:not([open]))]:pb-0! group-focus-visible/session:outline-2 group-focus-visible/session:outline-offset-4 group-focus-visible/session:outline-primary"><span aria-hidden="true" data-border-shine="" class="pointer-events-none absolute -inset-px z-[2] rounded-[inherit] opacity-55 [box-shadow:inset_0_0_1px_0.8px_color-mix(in_oklab,var(--violet-deep)_60%,var(--foreground))] [mask-image:linear-gradient(var(--border-shine-angle,-35deg),#ffffff80,#ffffff30_30%_60%,#fff)]"></span><div class="lineup-topic"><h4>Trust, but Verify: Building Compliant AI on AWS in a Changing Regulatory Landscape</h4></div><div class="lineup-speakers"><div class="lineup-speaker"><p class="lineup-speaker-name"><a href="index.html#speaker-mikhail-ruchkin" aria-label="View Mikhail Ruchkin&#x27;s speaker card" class="inline-flex min-h-11 items-center gap-2 rounded-sm text-inherit underline decoration-dotted decoration-current/50 underline-offset-4 hover:text-coral hover:decoration-coral/50 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary">Mikhail Ruchkin</a></p><p class="lineup-affiliation">CEO, Innovative Digital Transformation</p></div></div><details class="group/talk col-span-full mt-5 min-w-0 border-t border-current/10"><summary class="flex min-h-14 w-fit cursor-pointer list-none items-center gap-2 rounded-sm text-sm font-semibold text-coral hover:text-foreground focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary [&amp;::-webkit-details-marker]:hidden"><svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" aria-hidden="true" class="remixicon size-4 shrink-0 group-open/talk:rotate-180 motion-safe:transition-transform motion-safe:duration-150"><path d="M11.9999 13.1714L16.9497 8.22168L18.3639 9.63589L11.9999 15.9999L5.63599 9.63589L7.0502 8.22168L11.9999 13.1714Z"></path></svg><span class="group-open/talk:hidden">About this talk</span><span class="hidden group-open/talk:inline">Hide description</span><span class="sr-only">: <!-- -->Trust, but Verify: Building Compliant AI on AWS in a Changing Regulatory Landscape</span></summary><p class="max-w-[68ch] pb-1 text-sm leading-relaxed text-muted-foreground">Explore what compliance means for AI in production and how to build more controlled AI systems on AWS. Learn how to approach trust and verification across AI workloads, use AWS capabilities to support compliance, and adapt to a changing regulatory landscape.</p></details><div class="lineup-portraits"><div class="lineup-pop-portrait" data-speaker="Mikhail Ruchkin"><span aria-hidden="true" data-portrait-glow="" class="pointer-events-none absolute inset-0 rounded-full bg-[color:color-mix(in_oklab,var(--violet-deep)_55%,var(--foreground))] opacity-20 blur-xl"></span><span class="lineup-portrait-circle" aria-hidden="true"><span class="absolute inset-0 rounded-full bg-[radial-gradient(circle_at_50%_65%,#4e0abb,transparent_75%)] opacity-30"></span></span><div class="lineup-portrait-crop"><img src="speakers/ruchkin.webp" srcSet="speakers/responsive/ruchkin-368.webp 368w, speakers/responsive/ruchkin-736.webp 736w, speakers/ruchkin.webp 1100w" sizes="(max-width: 700px) 150px, 204px" alt="Mikhail Ruchkin" loading="lazy" width="1100" height="1320"/></div></div></div></div></li><li id="talk-1730" tabindex="-1" class="lineup-session group/session scroll-mt-28 focus-visible:outline-none" data-kind="talk" data-has-portrait="true" data-compact="false"><div class="lineup-time"><time dateTime="17:30">17:30</time><span class="lineup-end"><span class="sr-only"> to </span><span aria-hidden="true">— </span><time dateTime="18:00">18:00</time></span></div><div class="lineup-panel [&amp;:has(&gt;details:not([open]))]:pb-0! group-focus-visible/session:outline-2 group-focus-visible/session:outline-offset-4 group-focus-visible/session:outline-primary"><span aria-hidden="true" data-border-shine="" class="pointer-events-none absolute -inset-px z-[2] rounded-[inherit] opacity-55 [box-shadow:inset_0_0_1px_0.8px_color-mix(in_oklab,var(--violet-deep)_60%,var(--foreground))] [mask-image:linear-gradient(var(--border-shine-angle,-35deg),#ffffff80,#ffffff30_30%_60%,#fff)]"></span><div class="lineup-topic"><h4>Beyond Structured Data: Bringing Real-Time to Multimodal Analytics on the Open Lakehouse</h4></div><div class="lineup-speakers"><div class="lineup-speaker"><p class="lineup-speaker-name"><a href="index.html#speaker-mingyu-chen" aria-label="View Mingyu Chen&#x27;s speaker card" class="inline-flex min-h-11 items-center gap-2 rounded-sm text-inherit underline decoration-dotted decoration-current/50 underline-offset-4 hover:text-coral hover:decoration-coral/50 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary">Mingyu Chen</a></p><p class="lineup-affiliation">Vice President of Engineering, VeloDB</p></div></div><details class="group/talk col-span-full mt-5 min-w-0 border-t border-current/10"><summary class="flex min-h-14 w-fit cursor-pointer list-none items-center gap-2 rounded-sm text-sm font-semibold text-coral hover:text-foreground focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary [&amp;::-webkit-details-marker]:hidden"><svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" aria-hidden="true" class="remixicon size-4 shrink-0 group-open/talk:rotate-180 motion-safe:transition-transform motion-safe:duration-150"><path d="M11.9999 13.1714L16.9497 8.22168L18.3639 9.63589L11.9999 15.9999L5.63599 9.63589L7.0502 8.22168L11.9999 13.1714Z"></path></svg><span class="group-open/talk:hidden">About this talk</span><span class="hidden group-open/talk:inline">Hide description</span><span class="sr-only">: <!-- -->Beyond Structured Data: Bringing Real-Time to Multimodal Analytics on the Open Lakehouse</span></summary><p class="max-w-[68ch] pb-1 text-sm leading-relaxed text-muted-foreground">Explore how Apache Doris brings real-time analytics to structured tables, JSON, documents and vectors across Apache Paimon, Apache Iceberg and AWS S3 Tables. See how SQL, full-text search and vector search can work together to support RAG and AI agents on the open lakehouse.</p></details><div class="lineup-portraits"><div class="lineup-pop-portrait" data-speaker="Mingyu Chen"><span aria-hidden="true" data-portrait-glow="" class="pointer-events-none absolute inset-0 rounded-full bg-[color:color-mix(in_oklab,var(--violet-deep)_55%,var(--foreground))] opacity-20 blur-xl"></span><span class="lineup-portrait-circle" aria-hidden="true"><span class="absolute inset-0 rounded-full bg-[radial-gradient(circle_at_50%_65%,#4e0abb,transparent_75%)] opacity-30"></span></span><div class="lineup-portrait-crop"><img src="speakers/chen.webp" srcSet="speakers/responsive/chen-368.webp 368w, speakers/responsive/chen-736.webp 736w, speakers/chen.webp 1100w" sizes="(max-width: 700px) 150px, 204px" alt="Mingyu Chen" loading="lazy" width="1100" height="1320"/></div></div></div></div></li><li id="talk-1800" tabindex="-1" class="lineup-session group/session scroll-mt-28 focus-visible:outline-none" data-kind="ceremony" data-has-portrait="false" data-compact="false"><div class="lineup-time"><time dateTime="18:00">18:00</time><span class="lineup-end"><span class="sr-only"> to </span><span aria-hidden="true">— </span><time dateTime="19:00">19:00</time></span></div><div class="lineup-panel [&amp;:has(&gt;details:not([open]))]:pb-0! group-focus-visible/session:outline-2 group-focus-visible/session:outline-offset-4 group-focus-visible/session:outline-primary"><div class="lineup-topic"><h4>Raffle &amp; closing ceremony</h4></div></div></li></ol></section></div><p class="lineup-note">All times are local to Tashkent. Schedule subject to change.</p></div></section><section id="speakers" class="px-4 py-16 sm:py-24"><div style="--reveal-duration:1000ms;--reveal-delay:0ms;--reveal-distance:0px" class="[&amp;[data-native-reveal=complete]]:transition-none [&amp;_[data-native-reveal=complete]]:transition-none [&amp;[data-native-reveal=primed]]:opacity-0 [&amp;_[data-native-reveal=primed]]:opacity-0 [&amp;[data-native-reveal=primed]]:translate-y-(--reveal-distance) [&amp;_[data-native-reveal=primed]]:translate-y-(--reveal-distance) [&amp;[data-native-reveal=revealing]]:transition-[opacity,translate] [&amp;_[data-native-reveal=revealing]]:transition-[opacity,translate]   [&amp;[data-native-reveal=revealing]]:duration-(--reveal-duration) [&amp;_[data-native-reveal=revealing]]:duration-(--reveal-duration) [&amp;[data-native-reveal=revealing]]:delay-(--reveal-delay) [&amp;_[data-native-reveal=revealing]]:delay-(--reveal-delay) [&amp;[data-native-reveal=revealing]]:ease-[cubic-bezier(0.215,0.61,0.355,1)] [&amp;_[data-native-reveal=revealing]]:ease-[cubic-bezier(0.215,0.61,0.355,1)] motion-reduce:[&amp;[data-native-reveal]]:opacity-100 motion-reduce:[&amp;_[data-native-reveal]]:opacity-100 motion-reduce:[&amp;[data-na